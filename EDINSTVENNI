    menu.Visible = not menu.Visible
end)

-- ====== ESP BOX ======
local espFolder = Instance.new("Folder")
espFolder.Name = "achzero_esp"
espFolder.Parent = gui

local espCache = {}

RunService.RenderStepped:Connect(function()
    for plr, data in pairs(espCache) do
        if not data.box or not data.box.Parent then
            espCache[plr] = nil
        end
    end

    for _, plr in ipairs(Players:GetPlayers()) do
        if plr == LP then continue end
        local char = plr.Character
        local hrp = char and char:FindFirstChild("HumanoidRootPart")
        local hum = char and char:FindFirstChildOfClass("Humanoid")
        
        if not (hrp and hum and hum.Health > 0) or not flags.espBox then
            if espCache[plr] then espCache[plr].box.Visible = false end
            continue
        end

        local isMurder, isSherif = false, false
        local backpack = plr:FindFirstChild("Backpack")
        for _, obj in ipairs(char:GetChildren()) do
            if obj:IsA("Tool") then
                if obj.Name == "Knife" then isMurder = true end
                if obj.Name == "Gun" or obj.Name == "Revolver" then isSherif = true end
            end
        end
        if backpack then
            for _, obj in ipairs(backpack:GetChildren()) do
                if obj:IsA("Tool") then
                    if obj.Name == "Knife" then isMurder = true end
                    if obj.Name == "Gun" or obj.Name == "Revolver" then isSherif = true end
                end
            end
        end

        local color = Color3.fromRGB(255, 255, 255)
        if isMurder then color = Color3.fromRGB(255, 0, 0) end
        if isSherif then color = Color3.fromRGB(0, 150, 255) end

        local data = espCache[plr]
        if not data then
            local box = Instance.new("Frame")
            box.BackgroundColor3 = color
            box.BackgroundTransparency = 0.8
            box.BorderSizePixel = 0
            box.Parent = espFolder
            
            local s = Instance.new("UIStroke")
            s.Thickness = 1.5
            s.Color = color
            s.Parent = box
            
            local hpBg = Instance.new("Frame")
            hpBg.Size = UDim2.new(0, 3, 1, 0)
            hpBg.Position = UDim2.new(-1, -5, 0, 0)
            hpBg.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
            hpBg.BorderSizePixel = 0
            hpBg.Parent = box
            
            local hpFill = Instance.new("Frame")
            hpFill.Size = UDim2.new(1, 0, 1, 0)
            hpFill.BackgroundColor3 = Color3.fromRGB(0, 255, 0)
            hpFill.BorderSizePixel = 0
            hpFill.Parent = hpBg
            
            data = { box = box, stroke = s, hpFill = hpFill }
            espCache[plr] = data
        end

        local head = char:FindFirstChild("Head")
        local pos, onScreen = Camera:WorldToViewportPoint(hrp.Position)
        local headPos = head and Camera:WorldToViewportPoint(head.Position)
        
        if onScreen and headPos then
            local height = math.abs(headPos.Y - pos.Y) * 2.2
            local width = height * 0.65
            local x = pos.X - (width / 2)
            local y = pos.Y - (height / 2)

            data.box.Visible = true
            data.box.Size = UDim2.fromOffset(width, height)
            data.box.Position = UDim2.fromOffset(x, y)
            
            data.box.BackgroundColor3 = color
            data.stroke.Color = color
            
            data.hpFill.Size = UDim2.new(1, 0, hum.Health / hum.MaxHealth, 0)
            if hum.Health / hum.MaxHealth > 0.6 then
                data.hpFill.BackgroundColor3 = Color3.fromRGB(0, 255, 0)
            elseif hum.Health / hum.MaxHealth > 0.3 then
                data.hpFill.BackgroundColor3 = Color3.fromRGB(255, 165, 0)
            else
                data.hpFill.BackgroundColor3 = Color3.fromRGB(255, 0, 0)
            end
        else
            data.box.Visible = false
        end
    end
end)

-- ====== AIMBOT ======
local function getMurder()
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr == LP then continue end
        local char = plr.Character
        if not char then continue end
        local hum = char:FindFirstChildOfClass("Humanoid")
        if not (hum and hum.Health > 0) then continue end
        for _, tool in ipairs(char:GetChildren()) do
            if tool:IsA("Tool") and tool.Name == "Knife" then return plr end
        end
        local bp = plr:FindFirstChild("Backpack")
        if bp then
            for _, tool in ipairs(bp:GetChildren()) do
                if tool:IsA("Tool") and tool.Name == "Knife" then return plr end
            end
        end
    end
end

RunService.RenderStepped:Connect(function()
    if not flags.aimbot then return end
    local char = LP.Character
    if not char then return end
    local hasGun = false
    for _, tool in ipairs(char:GetChildren()) do
        if tool:IsA("Tool") and (tool.Name == "Gun" or tool.Name == "Revolver") then hasGun = true end
    end
    if not hasGun then return end
    local target = getMurder()
    if not target then return end
    local tHead = target.Character and target.Character:FindFirstChild("Head")
    if tHead then
        Camera.CFrame = CFrame.lookAt(Camera.CFrame.Position, tHead.Position)
    end
end)

-- ====== AUTO SHERIF ======
RunService.Stepped:Connect(function()
    if not flags.autoSherif then return end
    local char = LP.Character
    if not char then return end
    for _, tool in ipairs(char:GetChildren()) do
        if tool:IsA("Tool") and (tool.Name == "Gun" or tool.Name == "Revolver") then
            local handle = tool:FindFirstChild("Handle")
            if handle then
                local hrp = char:FindFirstChild("HumanoidRootPart")
                if hrp then
                    handle.CFrame = hrp.CFrame * CFrame.new(0, 0, -2) * CFrame.Angles(0, math.rad(180), 0)
                end
            end
        end
    end
end)

-- ====== ANTIAIM ======
