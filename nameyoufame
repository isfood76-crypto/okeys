local toggleStates = { esp = false, fling = false, antiaim = false }

local function setToggle(btn, key, name)
    toggleStates[key] = not toggleStates[key]
    btn.Text = name .. (toggleStates[key] and "  [ON]" or "  [OFF]")
    btn.TextColor3 = toggleStates[key] and Color3.fromRGB(0, 255, 170) or Color3.fromRGB(200, 200, 200)
end

