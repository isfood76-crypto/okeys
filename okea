        hum.WalkSpeed = flags.speedX2 and defaultSpeed * 2 or defaultSpeed
    end
end)

-- ====== JUMP x2 ======
local defaultJump = 50
RunService.Stepped:Connect(function()
    local hum = LP.Character and LP.Character:FindFirstChildOfClass("Humanoid")
    if hum then
        hum.JumpPower = flags.jumpX2 and defaultJump * 2 or defaultJump
        hum.UseJumpPower = true
    end
end)

-- ====== TOUCH FLING ======
local flinging = false
RunService.Stepped:Connect(function()
    if not flags.touchFling then return end
    local char = LP.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    if not hrp then return end
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr == LP then continue end
        local tChar = plr.Character
        local tHrp = tChar and tChar:FindFirstChild("HumanoidRootPart")
        if tHrp and (tHrp.Position - hrp.Position).Magnitude < 4 then
            local dir = (tHrp.Position - hrp.Position).Unit
            local rand = Vector3.new(math.random(-10, 10), math.random(5, 20), math.random(-10, 10))
            tHrp.AssemblyLinearVelocity = (dir + rand) * 500
            tHrp.RotVelocity = Vector3.new(math.random(-50, 50), math.random(-50, 50), math.random(-50, 50))
        end
    end
end)

