-- ====== ESP СИСТЕМА ======
local espFolder = Instance.new("Folder")
espFolder.Name = "achzero_esp"
espFolder.Parent = gui

local function createBox(plr)
    local box = Instance.new("Frame")
    box.BackgroundTransparency = 1
    box.BorderSizePixel = 0
    box.Parent = espFolder
    local s = Instance.new("UIStroke")
    s.Thickness = 1.5
    s.Color = Color3.fromRGB(0, 255, 0)
    s.Parent = box
    local label = Instance.new("TextLabel")
    label.Size = UDim2.new(1, 0, 0, 16)
    label.Position = UDim2.new(0, 0, 0, -18)
    label.BackgroundTransparency = 1
    label.TextScaled = true
    label.Font = Enum.Font.GothamBold
    label.TextColor3 = Color3.fromRGB(255, 255, 255)
    label.Parent = box
    return box, label, s
end

local espCache = {}

RunService.RenderStepped:Connect(function()
    -- очистка
    for plr, data in pairs(espCache) do
        if not data.box or not data.box.Parent then
            espCache[plr] = nil
        end
    end

    for _, plr in ipairs(Players:GetPlayers()) do
        if plr == LP then continue end
        local char = plr.Character
        local hrp = char and char:FindFirstChild("HumanoidRootPart")
        local hum = char and char:FindFirstChildOfClass("Humanoid")
        if not (hrp and hum and hum.Health > 0) then
            if espCache[plr] then
                espCache[plr].box.Visible = false
            end
            continue
        end

        -- проверка ролей
        local isMurder = false
        local isSherif = false
        local backpack = plr:FindFirstChild("Backpack")
        for _, tool in ipairs(char:GetChildren()) do
            if tool:IsA("Tool") then
                if tool.Name == "Knife" then isMurder = true end
                if tool.Name == "Gun" or tool.Name == "Revolver" then isSherif = true end
            end
        end
        if backpack then
            for _, tool in ipairs(backpack:GetChildren()) do
                if tool:IsA("Tool") then
                    if tool.Name == "Knife" then isMurder = true end
                    if tool.Name == "Gun" or tool.Name == "Revolver" then isSherif = true end
                end
            end
        end

        local show = false
        local color = Color3.fromRGB(255, 255, 255)
        local txt = plr.Name

        if flags.espAll then
            show = true
            color = Color3.fromRGB(255, 255, 255)
        end
        if flags.espMurder_only and isMurder then
            show = true; color = Color3.fromRGB(255, 0, 0); txt = plr.Name .. " [MURDER]"
        end
        if flags.espMurder and (isMurder or isSherif) then
            show = true
            if isMurder then color = Color3.fromRGB(255, 0, 0); txt = plr.Name .. " [MURDER]" end
            if isSherif then color = Color3.fromRGB(0, 150, 255); txt = plr.Name .. " [SHERIF]" end
        end
        if flags.espSherif and isSherif then
            show = true; color = Color3.fromRGB(0, 150, 255); txt = plr.Name .. " [SHERIF]"
        end
        if flags.espBox then
            show = true
            if color == Color3.fromRGB(255, 255, 255) then color = Color3.fromRGB(0, 255, 0) end
        end

        local data = espCache[plr]
        if show then
            if not data then
                local box, label, s = createBox(plr)
                data = { box = box, label = label, stroke = s }
                espCache[plr] = data
            end
            local pos, onScreen = Camera:WorldToViewportPoint(hrp.Position)
            if onScreen then
                local head = char:FindFirstChild("Head")
                local headPos = head and Camera:WorldToViewportPoint(head.Position) or pos
                local height = math.abs(headPos.Y - pos.Y) * 2
                local width = height * 0.6
                data.box.Visible = true
                data.box.Size = UDim2.fromOffset(width, height)
                data.box.Position = UDim2.fromOffset(pos.X - width / 2, pos.Y - height / 2)
                data.stroke.Color = color
                data.label.Text = txt
                data.label.TextColor3 = color
            else
                data.box.Visible = false
            end
        elseif data then
            data.box.Visible = false
        end
    end
end)

-- ====== AIMBOT (для шерифа) ======
local function getMurder()
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr == LP then continue end
        local char = plr.Character
        if not char then continue end
        local hum = char:FindFirstChildOfClass("Humanoid")
        if not (hum and hum.Health > 0) then continue end
        for _, tool in ipairs(char:GetChildren()) do
            if tool:IsA("Tool") and tool.Name == "Knife" then
                return plr
            end
        end
        local bp = plr:FindFirstChild("Backpack")
        if bp then
            for _, tool in ipairs(bp:GetChildren()) do
                if tool:IsA("Tool") and tool.Name == "Knife" then
                    return plr
                end
            end
        end
    end
end

RunService.RenderStepped:Connect(function()
    if not flags.aimbot then return end
    -- проверка что у нас пистолет
    local char = LP.Character
    if not char then return end
    local hasGun = false
    for _, tool in ipairs(char:GetChildren()) do
        if tool:IsA("Tool") and (tool.Name == "Gun" or tool.Name == "Revolver") then
            hasGun = true
        end
    end
    if not hasGun then return end

    local target = getMurder()
    if not target then return end
    local tChar = target.Character
    local tHead = tChar and tChar:FindFirstChild("Head")
    if tHead then
        Camera.CFrame = CFrame.lookAt(Camera.CFrame.Position, tHead.Position)
    end
end)

-- ====== AUTO SHERIF (поднимать пистолет) ======
RunService.Stepped:Connect(function()
    if not flags.autoSherif then return end
    local char = LP.Character
    if not char then return end
    for _, tool in ipairs(char:GetChildren()) do
        if tool:IsA("Tool") and (tool.Name == "Gun" or tool.Name == "Revolver") then
            local handle = tool:FindFirstChild("Handle")
            if handle then
                -- поднимаем и ориентируем
                local hrp = char:FindFirstChild("HumanoidRootPart")
                if hrp then
                    handle.CFrame = hrp.CFrame * CFrame.new(0, 0, -2) * CFrame.Angles(0, math.rad(180), 0)
                end
            end
        end
    end
end)

-- ====== ANTIAIM ======
RunService.RenderStepped:Connect(function()
    if not flags.antiaim then return end
    local char = LP.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    if hrp then
        hrp.CFrame = hrp.CFrame * CFrame.Angles(0, math.rad(math.random(0, 360)), 0)
    end
end)

