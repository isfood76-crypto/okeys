-- ===================== Движение кружка + открытие/закрытие =====================
-- Один обработчик: тащим только если сдвинулись > 4px, иначе — переключаем меню.
do
    local dragging, dragStart, startPos, moved = false, nil, nil, false
    toggle.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            moved = false
            dragStart = input.Position
            startPos = toggle.Position
        end
    end)
    toggle.InputChanged:Connect(function(input)
        if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
            local d = input.Position - dragStart
            if math.abs(d.X) > 4 or math.abs(d.Y) > 4 then
                moved = true
                toggle.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + d.X, startPos.Y.Scale, startPos.Y.Offset + d.Y)
            end
        end
    end)
    toggle.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            if dragging and not moved then
                main.Visible = not main.Visible   -- клик без движения = открыть/закрыть
            end
            dragging = false
        end
    end)
end

-- ===================== ESP Box =====================
local espFolder = Instance.new("Folder", gui)
espFolder.Name = "ESP"
local espData = {}

local function getRoleColor(plr)
    local ok, role = pcall(function()
        local c = plr.Character
        return c and (c:GetAttribute("Role") or (c:FindFirstChild("Role") and c.Role.Value))
    end)
    if ok and role then
        local r = tostring(role):lower()
        if r:find("murder") then return Color3.fromRGB(255, 40, 40) end
        if r:find("sheriff") then return Color3.fromRGB(40, 140, 255) end
    end
    return Color3.fromRGB(255, 255, 255) -- innocent / обычный = белый
end

local function createESP(plr)
    if plr == LocalPlayer or espData[plr] then return end
    local box = Instance.new("Frame")
    box.BackgroundTransparency = 1
    box.BorderSizePixel = 0
    box.Visible = false
    box.Parent = espFolder
    local stroke = Instance.new("UIStroke", box)
    stroke.Thickness = 1.5
    stroke.Color = Color3.fromRGB(255, 255, 255)
    stroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border

    local hpBack = Instance.new("Frame")
    hpBack.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
    hpBack.BorderSizePixel = 0
    hpBack.Visible = false
    hpBack.Parent = espFolder

    local hpBar = Instance.new("Frame")
    hpBar.BackgroundColor3 = Color3.fromRGB(0, 255, 100)
    hpBar.BorderSizePixel = 0
    hpBar.Visible = false
    hpBar.Parent = espFolder

    local nameLbl = Instance.new("TextLabel")
    nameLbl.BackgroundTransparency = 1
    nameLbl.Font = Enum.Font.GothamBold
    nameLbl.TextSize = 12
    nameLbl.TextStrokeTransparency = 0
    nameLbl.Visible = false
    nameLbl.Parent = espFolder

    espData[plr] = { box = box, stroke = stroke, hpBack = hpBack, hpBar = hpBar, nameLbl = nameLbl }
end

for _, p in ipairs(Players:GetPlayers()) do createESP(p) end
Players.PlayerAdded:Connect(createESP)
Players.PlayerRemoving:Connect(function(p)
    local d = espData[p]
    if d then
        for _, v in pairs(d) do v:Destroy() end
        espData[p] = nil
    end
end)

RunService.RenderStepped:Connect(function()
    for plr, d in pairs(espData) do
        local visible = state.esp
        local char = plr.Character
        local hrp = char and char:FindFirstChild("HumanoidRootPart")
        local hum = char and char:FindFirstChildOfClass("Humanoid")
        if visible and hrp and hum and hum.Health > 0 then
            local pos, onScreen = workspace.CurrentCamera:WorldToViewportPoint(hrp.Position)
            if onScreen then
                local dist = (workspace.CurrentCamera.CFrame.Position - hrp.Position).Magnitude
                local h = math.clamp(1800 / math.max(dist, 1), 20, 300)
                local w = h * 0.55
                local color = getRoleColor(plr)

                -- BOX
                d.box.Visible = true
                d.box.Size = UDim2.new(0, w, 0, h)
                d.box.Position = UDim2.new(0, pos.X - w/2, 0, pos.Y - h/2)
                d.stroke.Color = color

                -- HP BAR (сверху бокса, ширина = ширина бокса, высота 4)
                local hpRatio = math.clamp(hum.Health / math.max(hum.MaxHealth, 1), 0, 1)
                local barH = 4
                d.hpBack.Visible = true
                d.hpBack.Size = UDim2.new(0, w, 0, barH)
                d.hpBack.Position = UDim2.new(0, pos.X - w/2, 0, pos.Y - h/2 - barH - 2)
                d.hpBar.Visible = true
                d.hpBar.Size = UDim2.new(0, w * hpRatio, 0, barH)
                d.hpBar.Position = d.hpBack.Position
                d.hpBar.BackgroundColor3 = Color3.fromRGB(0, 255, 100):Lerp(Color3.fromRGB(255, 0, 0), 1 - hpRatio)

                -- NAME над HP
                d.nameLbl.Visible = true
                d.nameLbl.Text = plr.Name
                d.nameLbl.TextColor3 = color
                d.nameLbl.Size = UDim2.new(0, 200, 0, 14)
                d.nameLbl.Position = UDim2.new(0, pos.X, 0, pos.Y - h/2 - barH - 18)
                d.nameLbl.AnchorPoint = Vector2.new(0.5, 0)
            else
                d.box.Visible = false; d.hpBack.Visible = false
                d.hpBar.Visible = false; d.nameLbl.Visible = false
            end
        else
            d.box.Visible = false; d.hpBack.Visible = false
            d.hpBar.Visible = false; d.nameLbl.Visible = false
        end
    end
end)

-- ===================== AntiAim =====================
local antiConn
local spin = 0
local function startAntiAim()
    if antiConn then return end
    antiConn = RunService.Heartbeat:Connect(function(dt)
        spin = spin + dt * 360
        local c = LocalPlayer.Character
        local r = c and c:FindFirstChild("HumanoidRootPart")
        if r then
            r.CFrame = r.CFrame * CFrame.Angles(0, math.rad(spin), 0)
        end
    end)
end
local function stopAntiAim()
    if antiConn then antiConn:Disconnect(); antiConn = nil end
end

-- ===================== Touch Fling (главный фикс) =====================
-- Логика: когда жертва ближе RADIUS — флингуем ТОЛЬКО её.
-- Себя не трогаем: нет CFrame на LocalPlayer, импульс через BodyVelocity на жертве.
-- Плюс отключаем коллизию HRP жертвы с HRP других на 0.3с, чтобы импульс не улетел тебе.
local flingConn
local FLING_RADIUS = 6
local FLING_SPEED  = 2500   -- подбери 1500–4000; больше = выше
local flingCooldown = {}    -- [plr] = time()

local function startFling()
    if flingConn then return end
    flingConn = RunService.Heartbeat:Connect(function()
        local lc = LocalPlayer.Character
        local lhrp = lc and lc:FindFirstChild("HumanoidRootPart")
        local lhum = lc and lc:FindFirstChildOfClass("Humanoid")
        if not (lhrp and lhum) or lhum.Health <= 0 then return end

        for _, plr in ipairs(Players:GetPlayers()) do
            if plr ~= LocalPlayer then
                local now = tick()
                if flingCooldown[plr] and now - flingCooldown[plr] < 0.8 then continue end
                local c = plr.Character
                local r = c and c:FindFirstChild("HumanoidRootPart")
                local h = c and c:FindFirstChildOfClass("Humanoid")
                if r and h and h.Health > 0 then
                    local dist = (r.Position - lhrp.Position).Magnitude
                    if dist < FLING_RADIUS then
                        flingCooldown[plr] = now
                        -- 1) Отключаем коллизию HRP жертвы с моим, чтобы импульс не передался мне
                        r.CanCollide = false
                        -- 2) Ставим жертву в PlatformStand чтобы Humanoid не гасил скорость
                        h.PlatformStand = true
                        -- 3) Импульс вверх через BodyVelocity на жертве
                        local bv = Instance.new("BodyVelocity")
                        bv.Velocity = Vector3.new(0, FLING_SPEED, 0)
                        bv.MaxForce = Vector3.new(1e6, 1e6, 1e6)
                        bv.P = 5000
                        bv.Parent = r
                        -- 4) Крутим жертву чтобы не зацепилась за карту
                        local bav = Instance.new("BodyAngularVelocity")
                        bav.AngularVelocity = Vector3.new(50, 50, 50)
                        bav.MaxTorque = Vector3.new(1e6, 1e6, 1e6)
                        bav.Parent = r
                        task.delay(0.5, function()
                            if bv then bv:Destroy() end
                            if bav then bav:Destroy() end
                            if h and h.Parent then h.PlatformStand = false end
                            if r and r.Parent then r.CanCollide = true end
                        end)
                    end
                end
            end
        end
    end)
end
local function stopFling()
    if flingConn then flingConn:Disconnect(); flingConn = nil end
end

-- ===================== ОДИН обработчик на кнопку (фикс "не работает при первом включении") =====================
local function bindToggle(btn, key, label, onStart, onStop)
    btn.MouseButton1Click:Connect(function()
        state[key] = not state[key]
        btn.Text = label .. (state[key] and "  [ON]" or "  [OFF]")
        btn.TextColor3 = state[key] and Color3.fromRGB(0, 255, 170) or Color3.fromRGB(200, 200, 200)
        if state[key] then
            if onStart then onStart() end
        else
            if onStop then onStop() end
        end
    end)
end

bindToggle(espBtn,     "esp",     "ESP Box",     nil,       nil)
bindToggle(flingBtn,   "fling",   "Touch Fling", startFling, stopFling)
bindToggle(antiaimBtn, "antiaim", "AntiAim",     startAntiAim, stopAntiAim)
